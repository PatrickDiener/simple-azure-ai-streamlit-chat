# The endpoint URL for your Azure AI model inference endpoint. Find this in the Azure AI Foundry portal under "Overview" > "Included capabilities" > "Azure AI inference" > "Azure AI model inference endpoint".
# Example: https://<your-aiservice-name>.services.ai.azure.com/models
AZURE_INFERENCE_SDK_ENDPOINT=

# API key for authenticating requests to the Azure AI model inference endpoint. Find this in the Azure AI Foundry portal under "Overview" > "Endpoints and keys" > "API Key".
AZURE_INFERENCE_SDK_KEY=

# List the deployed model names, separated by commas, that are available for inference. These models will appear in the model selection dropdown.
# Example: gpt-4o-mini,gpt-4o,gpt-35-turbo,o1,DeepSeek-V3-0324
AZURE_INFERENCE_DEPLOYED_MODELS=
